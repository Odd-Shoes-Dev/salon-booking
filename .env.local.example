# Neon Database (same DB as the main salon system)
DATABASE_URL=postgresql://...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Root domain for owned-domain salons (change this to rebrand without touching code)
# Booking:  {slug}.ROOT_DOMAIN           e.g. posh.blueoxgroup.eu
# System:   system-{slug}.ROOT_DOMAIN    e.g. system-posh.blueoxgroup.eu
NEXT_PUBLIC_ROOT_DOMAIN=blueoxgroup.eu 

# ── SMS Provider (optional — booking confirmation texts to guests) ──────────
# MTN numbers (076/077/078/079) always route through sms.ug below — Africa's
# Talking can't reach MTN. Everything else uses whichever provider
# SMS_PROVIDER selects ("esms" or "africastalking"); keep this in sync with
# the main system's SMS_PROVIDER so both apps send through the same account.
# Defaults to "esms" if unset.
SMS_PROVIDER=africastalking

# sms.ug (MTN numbers — required for MTN delivery regardless of SMS_PROVIDER)
# Note: their content filter rejects messages containing "code"/"OTP"/
# "passcode" — see sendOtpSms in lib/sms.ts.
SMSUG_API_KEY=

# Africa's Talking (SMS_PROVIDER=africastalking)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=   # optional — leave blank to use default

# eSMS Africa (SMS_PROVIDER=esms)
ESMS_API_KEY=
ESMS_BASE_URL=https://sms.esmsafrica.io

# Main system origin (for CORS if needed)
SYSTEM_ORIGIN=http://localhost:3001
